<!DOCTYPE html>
<html lang="es">
  <head>
    <meta
      charset="UTF-8"
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link
      rel="icon"
      type="image/x-icon"
      href="<%= server_url %>/api/ico/logo/favicon.ico<%= `?v=${Date.now()}` %>"
    />

    <link
      rel="stylesheet"
      type="text/css"
      href="<%= server_url %>/api/css/errors/at_get.error.css<%= `?v=${Date.now()}` %>"
    />

    <title><%= title %></title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/">Inicio</a>
        <a href="/register"
          id="register"
          class="special"
        >Registarse</a>
        <a href="/login"
          id="login"
          class="special"
        >Iniciar Sesión</a>
      </nav>
    </header>

    <hr />

    <main>
      <section>
        <h2>La ruta <% route %> no existe...</h2>
        <p>Uh... el servidor dio un error-404</p>

        <hr />

        <span><%= error %></span>
      </section>
    </main>
  </body>
</html>
