<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="<%= server_url %>/css/public/reset.public.css">
  <link rel="stylesheet" href="<%= server_url %>/css/private/dashboard.private.css">
  <link rel="stylesheet" href="<%= server_url %>/css/private/add_campaign.private.css">
</head>
<body>
  <main class="dashboard-section">
    <div class="add-campaign-container">
      <h2>Crear Nueva Campaña</h2>
      <form action="/dashboard/add/campaign" method="POST" class="add-campaign-form">
        <div class="add-campaign-group">
          <label>Título:</label>
          <input type="text" name="campaign[title]" required>
        </div>
        <div class="add-campaign-group">
          <label>Descripción:</label>
          <textarea name="campaign[description]" rows="5" required></textarea>
        </div>
        <div class="add-campaign-group">
          <label>URL de la Imagen:</label>
          <input type="url" name="campaign[image_url]" required>
        </div>
        <button type="submit" class="add-campaign-btn-submit">Guardar Campaña</button>
      </form>
    </div>
  </main>
</body>
</html>