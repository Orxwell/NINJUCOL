<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">

    <%- include('../components/links.component.ejs', { pages: [{ route: 'private', name: 'add_new' }] }) %>

    <%- include('../components/scripts.component.ejs', { resources: [{ route: 'private', name: 'multipart' }] }) %>

    <title><%= title %></title>
  </head>

  <body>
    <%- include('../components/top.component.ejs', { page: 'add_new', }) %>
    
    <%- include('../components/bar.component.ejs', { page: 'add_new', }) %>

    <script>
      const allowedTypesByInput = {
        resource: [
          'image/jpeg',
          'image/png',
          'image/webp',
        ],
      };
    </script>

    <main class="dashboard-section">
      <div class="add-new-container">
        <h2>Editar Noticia</h2>

        <!-- El action incluye el uuid dinámico para que la ruta lo reciba en req.query -->
        <form
          action="/dashboard/upd/new?uuid=<%= data.uuid %>"
          method="POST"
          class="add-new-form"
          enctype="multipart/form-data"
        >
          <div class="add-new-group">
            <label>Título:</label>

            <input
              type="text"
              name="title"
              value="<%= data.title %>"
              required
            />
          </div>

          <div class="add-new-group">
            <label>Autor:</label>

            <input
              type="text"
              name="author"
              value="<%= data.author %>"
              required
            />
          </div>

          <div class="add-new-group">
            <label>Resumen:</label>

            <!-- CORREGIDO: El contenido va dentro del textarea, no en un atributo value -->
            <textarea
              name="resume"
              rows="2"
              required
            ><%= data.resume %></textarea>
          </div>

          <div class="add-new-group">
            <label>Descripción:</label>

            <!-- CORREGIDO: El contenido va dentro del textarea, no en un atributo value -->
            <textarea
              name="description"
              rows="5"
              required
            ><%= data.description %></textarea>
          </div>

          <div class="add-new-group">
            <label>Portada actual / Cambiar:</label>

            <% if (data.resource_uri) { %>
              <div style="margin-bottom: 0.5rem;">
                <img src="<%= data.resource_uri %>" alt="Portada actual" width="100" style="border-radius: 6px;">
              </div>
            <% } %>

            <input
              type="file"
              id="resource"
              name="resource"
              accept=".jpg,.jpeg,.png,.webp"
            />

            <!-- Campo oculto vital: Mantiene la resource_uri anterior si el usuario no sube una foto nueva -->
            <input type="hidden" name="resource_uri" value="<%= data.resource_uri %>">
          </div>

          <div class="add-new-group">
            <label>URL de YouTube (opcional):</label>

            <input
              type="url"
              id="video_url"
              name="video_url"
              value="<%= data.video_url %>"
            />

            <script>
              const $npt = document.getElementById('video_url');

              if ($npt && $npt.form) {
                $npt.form.addEventListener('submit', () => {
                  if (!$npt.value.trim()) {
                    $npt.value = 'https://www.youtube.com/watch?v=jNQXAC9IVRw';
                  }
                });
              }
            </script>
          </div>

          <button type="submit" class="add-new-btn-submit">Guardar Cambios</button>
        </form>

        <a href="/dashboard">Regresar</a>
      </div>
    </main>

    <%- include('../components/footer.component.ejs') %>
  </body>
</html>