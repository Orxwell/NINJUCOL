<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">

    <%- include('../components/links.component.ejs', { pages: [{ route: 'private', name: 'add_repository' }] }) %>

    <%- include('../components/scripts.component.ejs', { resources: [{ route: 'private', name: 'multipart' }] }) %>

    <title><%= title %></title>
  </head>

  <body>
    <%- include('../components/top.component.ejs', { page: 'add_repository', }) %>
    
    <%- include('../components/bar.component.ejs', { page: 'add_repository', }) %>

    <script>
      const allowedTypesByInput = {
        resource: [
          'image/jpeg',
          'image/png',
          'image/webp',

          'application/pdf',
        ],
      };
    </script>

    <main class="dashboard-section">
      <div class="add-repository-container">
        <h2>Crear nuevo recurso</h2>

        <form
          action="/dashboard/add/repository"
          method="POST"
          class="add-repository-form"
          enctype="multipart/form-data"
        >
          <div class="add-repository-group">
            <label>Título:</label>

            <input
              type="text"
              name="title"
              required
            />
          </div>

          <div class="add-repository-group">
            <label>Descripción:</label>

            <textarea
              name="description"
              rows="5"
              required
            ></textarea>
          </div>

          <div class="add-repository-group">
            <label>Archivo:</label>

            <input
              type="file"
              id="resource"
              name="resource"
              accept=".jpg,.jpeg,.png,.webp,.pdf"
            />
          </div>

          <button type="submit" class="add-repository-btn-submit">Guardar Recurso</button>
        </form>
      </div>
    </main>
  </body>
</html>
