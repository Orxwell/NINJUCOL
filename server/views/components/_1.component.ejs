<section class="_1">
  <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
    <image
      href="<%= server_url %>/api/webp/public/_1.public.webp<%= `?v=${Date.now()}` %>"
      x="0"
      y="0"
      width="100%"
      height="100%"
      preserveAspectRatio="xMidYMid slice"
      style="opacity: 0; transition: opacity .5s ease-in;"
      onload="this.style.opacity='1'"
    />
  </svg>

  <div class="hero-overlay"></div>
  
  <div class="hero-content">
    <span class="hero-badge">PREVENCIÓN & CONVIVENCIA</span>
    <h2>Fundación Niñez y Juventud</h2>
    <p class="hero-subtitle">Convivencia que se construye y vínculos que se restauran.</p>
    <p>Trabajamos con entornos escolares donde niñas, niños y jóvenes puedan crecer, educarse y relacionarse desde el diálogo, la responsabilidad y el cuidado.</p>
    <div class="hero-actions">
      <a href="/donate" class="btn-donate-now">DONAR AHORA</a>
      <a href="/about_us" class="btn-about-us">Sobre Nosotros</a>
    </div>
  </div>
</section>
