<section class="join-section" id="unete">
  <div class="join-container">
    <div class="join-header">
      <h2>ÚNETE A NUESTRA CAUSA</h2>
      <p>Sé parte del cambio. Conviértete en voluntario o vincula a tu empresa como aliado.</p>
    </div>

    <!-- Formulario que enviará los datos por POST a tu ruta del servidor -->
    <form class="join-form" action="/api/join" method="POST">
      
      <div class="form-group">
        <label for="nombre">Nombre completo</label>
        <input type="text" id="nombre" name="nombre" placeholder="Ej. Ana María Gómez" required>
      </div>

      <div class="form-group">
        <label for="asunto">Razón o Asunto</label>
        <input type="text" id="asunto" name="asunto" placeholder="Ej. Propuesta de apoyo escolar / Voluntariado fines de semana" required>
      </div>

      <div class="form-group">
        <label for="mensaje">Mensaje explicativo</label>
        <textarea id="mensaje" name="mensaje" rows="5" placeholder="Cuéntanos más sobre ti o tu organización..." required></textarea>
      </div>

      <!-- Checkboxes para Voluntario o Aliado -->
      <div class="form-options">
        <label class="checkbox-label">
          <input type="checkbox" name="tipo" value="Voluntario">
          <span>Quiero ser Voluntario</span>
        </label>

        <label class="checkbox-label">
          <input type="checkbox" name="tipo" value="Aliado">
          <span>Quiero ser Aliado (Empresas)</span>
        </label>
      </div>

      <button type="submit" class="btn-submit">Enviar Solicitud</button>
    </form>
  </div>
</section>