<section class="_6">
  <div class="_6-container">
    <div class="_6-mision-header">
      <h2>Misión</h2>
      <p>Construimos espacios donde el diálogo, el respeto y la resolución pacífica de conflictos transforman la experiencia escolar y comunitaria.</p>
    </div>

    <div class="_6-mision-circulos">
      
      <!-- Círculo 1: Azul Sea -->
      <div class="_6-circulo _6-circulo-sea">
        <div class="_6-icono-contenedor">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <image
              href="<%= server_url %>/api/webp/public/iconMission1.png<%= `?v=${Date.now()}` %>"
              x="0" y="0" width="100%" height="100%"
              preserveAspectRatio="xMidYMid meet"
              style="opacity: 0; transition: opacity .5s ease-in;"
              onload="this.style.opacity='1'"
            />
          </svg>
        </div>
        <h3>CONVIVENCIA</h3>
        <p>Promovemos entornos seguros basados en el respeto mutuo.</p>
      </div>

      <!-- Círculo 2: Azul Sea Dark -->
      <div class="_6-circulo _6-circulo-dark">
        <div class="_6-icono-contenedor">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <image
              href="<%= server_url %>/api/webp/public/iconMission2.png<%= `?v=${Date.now()}` %>"
              x="0" y="0" width="100%" height="100%"
              preserveAspectRatio="xMidYMid meet"
              style="opacity: 0; transition: opacity .5s ease-in;"
              onload="this.style.opacity='1'"
            />
          </svg>
        </div>
        <h3>DIÁLOGO</h3>
        <p>Facilitamos herramientas para la comunicación asertiva.</p>
      </div>

      <!-- Círculo 3: Naranja Tangerine -->
      <div class="_6-circulo _6-circulo-tangerine">
        <div class="_6-icono-contenedor">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <image
              href="<%= server_url %>/api/webp/public/iconMission3.png<%= `?v=${Date.now()}` %>"
              x="0" y="0" width="100%" height="100%"
              preserveAspectRatio="xMidYMid meet"
              style="opacity: 0; transition: opacity .5s ease-in;"
              onload="this.style.opacity='1'"
            />
          </svg>
        </div>
        <h3>INCLUSIÓN</h3>
        <p>Acompañamos a comunidades para que nadie quede atrás.</p>
      </div>

    </div>
  </div>
</section>