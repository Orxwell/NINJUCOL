                    style="opacity: 0; transition: opacity .5s ease-in;"
                    onload="this.style.opacity='1'"
                    />
                </svg>  
            </div>
          </div>

        </div>
      </div>

      <button class="carousel-btn next" id="partners-next" aria-label="Siguiente">
        <svg viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

    </div>

    <div class="partners-pagination" id="partners-pagination">
    </div>

  </div>
</section>