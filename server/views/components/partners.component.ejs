<section class="partners-section">
  <div class="partners-container">
    
    <div class="partners-dots">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <h2 class="partners-title">NUESTROS ALIADOS</h2>

    <div class="partners-carousel-wrapper">
      
      <button class="carousel-btn prev" id="partners-prev" aria-label="Anterior">
        <svg viewBox="0 0 24 24">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="partners-carousel-track-container">
        <div class="partners-carousel-track" id="partners-track">
          
          <div class="partner-card">
            <div class="partner-logo-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                    <image
                    href="<%= server_url %>/api/webp/public/_9.public.webp<%= `?v=${Date.now()}` %>"
                    x="0"
                    y="0"
                    width="100%"
                    height="100%"
                    preserveAspectRatio="xMidYMid meet"
                    style="opacity: 0; transition: opacity .5s ease-in;"
                    onload="this.style.opacity='1'"
                    />
                </svg>  
            </div>
          </div>

          <div class="partner-card">
            <div class="partner-logo-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                    <image
                    href="<%= server_url %>/api/webp/public/_9.public.webp<%= `?v=${Date.now()}` %>"
                    x="0"
                    y="0"
                    width="100%"
                    height="100%"
                    preserveAspectRatio="xMidYMid meet"
                    style="opacity: 0; transition: opacity .5s ease-in;"
                    onload="this.style.opacity='1'"
                    />
                </svg>           
             </div>
          </div>

          <div class="partner-card">
            <div class="partner-logo-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                    <image
                    href="<%= server_url %>/api/webp/public/_9.public.webp<%= `?v=${Date.now()}` %>"
                    x="0"
                    y="0"
                    width="100%"
                    height="100%"
                    preserveAspectRatio="xMidYMid meet"
                    style="opacity: 0; transition: opacity .5s ease-in;"
                    onload="this.style.opacity='1'"
                    />
                </svg>  
            </div>
          </div>

          <div class="partner-card">
            <div class="partner-logo-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
                    <image
                    href="<%= server_url %>/api/webp/public/_9.public.webp<%= `?v=${Date.now()}` %>"
