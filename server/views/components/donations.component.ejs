<section class="_4">
  <div id="donations">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="100%"
      height="100%"
    >
      <image
        href="<%= server_url %>/api/webp/public/banner_1.webp<%= `?v=${Date.now()}` %>"
        x="0"
        y="0"
        width="100%"
        height="100%"
        preserveAspectRatio="xMidYMid slice"
        style="opacity: 0; transition: opacity .5s ease-in;"
        onload="this.style.opacity='1'"
      />
    </svg>

    <form
      action="/donations"
      method="POST"
    >
      <h3>Ayúdanos a llegar a más niños</h3>

      <fieldset class="donation-options">
        <label class="option">
          <input
            type="radio"
            value="10000"
            checked
          />

          <span>10.000 COP</span>
        </label>

        <label class="option">
          <input
            type="radio"
            value="50000"
          />

          <span>50.000 COP</span>
        </label>

        <label class="option">
          <input
            type="radio"
            value="100000"
          />

          <span>100.000 COP</span>
        </label>

        <label class="option">
          <input
            type="radio"
            value="custom"
          />

          <span>Otro</span>
        </label>
      </fieldset>

      <div class="custom-donation" hidden>
        <label for="custom-option">Ingresa un monto</label>
        
        <input
          id="custom-option"
          type="number"
          min="1000"
          step="1000"
          placeholder="Ej. 20.000 COP"
          disabled
        />
      </div>

      <div class="donation-summary" aria-live="polite">
        <p>Tu donación será:</p>

        <strong id="donation-display">10.000 COP</strong>
      </div>

      <input
        type="hidden"
        name="amount"
        id="donation-amount"
        value="10000"
      />

      <button type="submit">Proceder</button>
    </form>
  </div>
</section>
