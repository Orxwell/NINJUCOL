<section class="donation-section-full">
    <div class="donation-grid-full">
        
        <!-- Left Column: Image -->
        <div class="donation-col-image">
            <img src="<%= server_url %>/api/webp/public/imagen2.webp<%= `?v=${Date.now()}` %>" alt="Niños de la fundación" class="donation-img-full">            <div class="donation-badge-float">
            <span>TU APOYO CAMBIA VIDAS</span>
            </div>
        </div>

        <!-- Right Column: Content & Form -->
        <div class="donation-col-content">
            <div class="donation-inner-wrapper">
                <span class="section-dots">...</span>
                <h2 class="donation-title">ÚNETE A LA CAUSA</h2>
                <p class="donation-subtitle">Ayúdanos a llevar programas de convivencia y prevención a más escuelas en Colombia.</p>

                <div class="donation-form">
                    <label class="form-label">SELECCIONA EL MONTO A DONAR (COP)</label>
                    
                    <div class="values-grid">
                        <button type="button" class="btn-value active" onclick="selectValue(10000, this)">10.000</button>
                        <button type="button" class="btn-value" onclick="selectValue(50000, this)">50.000</button>
                        <button type="button" class="btn-value" onclick="selectValue(100000, this)">100.000</button>
                        <input type="number" class="input-other" id="inputOther" placeholder="Otro" oninput="captureOther(this.value)">
                    </div>

                    <div class="projection-box">
                        <span class="projection-text">APORTE TOTAL SELECCIONADO</span>
                        <p class="projection-value" id="projectedValue">10.000 COP</p>
                    </div>

                    <button type="button" class="btn-donate-submit">CONTINUAR DONACIÓN &rarr;</button>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
    const visor = document.getElementById('projectedValue');
    const inputOther = document.getElementById('inputOther');

    function selectValue(amount, button) {
        inputOther.value = '';
        document.querySelectorAll('.btn-value').forEach(b => b.classList.remove('active'));
        button.classList.add('active');
        visor.innerText = amount.toLocaleString('es-CO') + ' COP';
    }

    function captureOther(value) {
        document.querySelectorAll('.btn-value').forEach(b => b.classList.remove('active'));
        if(value && value > 0) {
            let number = parseFloat(value);
            visor.innerText = number.toLocaleString('es-CO') + ' COP';
        } else {
            visor.innerText = '0 COP';
        }
    }
</script>