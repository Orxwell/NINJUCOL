<section class="signup-section">
  <div class="signup-container">
    
    <!-- Columna Izquierda: Tarjeta de Bienvenida con Imagen -->
    <div class="signup-brand-col">
      <div class="signup-brand-overlay"></div>
      <div class="signup-brand-content">
        <span class="signup-badge">NINJUCOL</span>
        <h2>Únete a nuestra red</h2>
        <p>Crea tu cuenta para formar parte de la transformación de entornos escolares y la convivencia restaurativa.</p>
      </div>
    </div>

    <!-- Columna Derecha: Formulario de Registro -->
    <div class="signup-form-col">
      <div class="signup-form-wrapper">
        
        <div class="signup-header">
          <h2>Crear Cuenta</h2>
          <p>Completa tus datos personales para solicitar acceso.</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="signup-error-box"><%= error %></div>
        <% } %>

        <form action="/sign_up" method="POST" class="signup-form">
          
          <!-- Campo: Nombre -->
          <div class="signup-form-group">
            <label for="firstname">Nombre</label>
            <div class="signup-input-wrapper">
              <svg class="signup-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <input 
                type="text" 
                id="firstname" 
                name="firstname" 
                placeholder="Tu nombre" 
                required 
                autocomplete="given-name"
              />
            </div>
          </div>

          <!-- Campo: Apellido -->
          <div class="signup-form-group">
            <label for="lastname">Apellido</label>
            <div class="signup-input-wrapper">
              <svg class="signup-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <input 
                type="text" 
                id="lastname" 
                name="lastname" 
                placeholder="Tu apellido" 
                required 
                autocomplete="family-name"
              />
            </div>
          </div>

          <!-- Campo: Fecha de Nacimiento -->
          <div class="signup-form-group">
            <label for="birthdate">Fecha de Nacimiento</label>
            <div class="signup-input-wrapper">
              <svg class="signup-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <input 
                type="date" 
                id="birthdate" 
                name="birthdate" 
                required 
              />
            </div>
          </div>

          <!-- Campo: Teléfono -->
          <div class="signup-form-group">
            <label for="phone">Teléfono</label>
            <div class="signup-input-wrapper">
              <svg class="signup-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                placeholder="+57 300 000 0000" 
                required 
                autocomplete="tel"
              />
            </div>
          </div>

          <!-- Campo: Correo Electrónico -->
          <div class="signup-form-group">
            <label for="email">Correo Electrónico</label>
            <div class="signup-input-wrapper">
              <svg class="signup-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="ejemplo@ninjucol.org" 
                required 
                autocomplete="email"
              />
            </div>
          </div>

          <!-- Campo: Contraseña -->
          <div class="signup-form-group">
            <label for="password">Contraseña</label>
            <div class="signup-input-wrapper">
              <svg class="signup-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <input 
                type="password" 
                id="password" 
                name="password" 
                placeholder="••••••••" 
                required 
                autocomplete="new-password"
              />
            </div>
          </div>

          <!-- Botón de Envío -->
          <button type="submit" class="signup-btn">
            REGISTRARME EN LA PLATAFORMA
          </button>

        </form>

        <!-- Footer del Formulario -->
        <div class="signup-footer">
          <p>¿Ya tienes una cuenta activa?</p>
            <a href="/sign_in" class="<%= page === 'sign_in' ? 'active' : '' %>">Iniciar sesión</a>
        </div>

      </div>
    </div>

  </div>
</section>