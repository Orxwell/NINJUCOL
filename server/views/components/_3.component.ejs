<section class="_3">
  <div class="_3-container">
    <!-- Encabezado de la sección -->
    <div class="_3-header">
      <h2>SERVICIOS PARA LA NIÑEZ</h2>
      <p>Metodologías enfocadas en el fortalecimiento pedagógico y comunitario.</p>
    </div>

    <!-- Grid de 4 tarjetas de servicios -->
    <div class="_4-grid">
      
      <!-- Tarjeta 1 -->
      <div class="_3-card">
        <div class="_3-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <image
              href="<%= server_url %>/api/png/public/_1.public.png<%= `?v=${Date.now()}` %>"
              x="0" y="0" width="100%" height="100%"
              preserveAspectRatio="xMidYMid meet"
              style="opacity: 0; transition: opacity .5s ease-in;"
              onload="this.style.opacity='1'"
            />
          </svg>
        </div>
        <h3>Facilitaciones e intervenciones</h3>
        <p>Estrategias en aula para el manejo constructivo de conflictos y la convivencia pacífica.</p>
      </div>

      <!-- Tarjeta 2 -->
      <div class="_3-card">
        <div class="_3-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <image
              href="<%= server_url %>/api/png/public/_2.public.png<%= `?v=${Date.now()}` %>"
              x="0" y="0" width="100%" height="100%"
              preserveAspectRatio="xMidYMid meet"
              style="opacity: 0; transition: opacity .5s ease-in;"
              onload="this.style.opacity='1'"
            />
          </svg>
        </div>
        <h3>Transferencia de habilidades</h3>
        <p>Capacitación y talleres prácticos dirigidos a educadores y formadores comunitarios.</p>
      </div>

      <!-- Tarjeta 3 -->
      <div class="_3-card">
        <div class="_3-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <image
              href="<%= server_url %>/api/png/public/_3.public.png<%= `?v=${Date.now()}` %>"
              x="0" y="0" width="100%" height="100%"
              preserveAspectRatio="xMidYMid meet"
              style="opacity: 0; transition: opacity .5s ease-in;"
              onload="this.style.opacity='1'"
            />
          </svg>
        </div>
        <h3>Trabajo Social</h3>
        <p>Acompañamiento y orientación psicosocial a familias en situación de vulnerabilidad.</p>
      </div>

      <!-- Tarjeta 4 -->
      <div class="_3-card">
        <div class="_3-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
            <image
              href="<%= server_url %>/api/png/public/_4.public.png<%= `?v=${Date.now()}` %>"
              x="0" y="0" width="100%" height="100%"
              preserveAspectRatio="xMidYMid meet"
              style="opacity: 0; transition: opacity .5s ease-in;"
              onload="this.style.opacity='1'"
            />
          </svg>
        </div>
        <h3>Fortalecimiento de competencias</h3>
        <p>Desarrollo de habilidades socioemocionales, empatía y liderazgo en niños y jóvenes.</p>
      </div>
    </div>
  </div>
</section>
