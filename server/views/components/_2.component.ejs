<section class="_2">
  <div class="_2-container">
    <!-- Columna Izquierda: Textos y enlace -->
    <div class="_2-text-col">
      <div class="_2-dots">
        <span></span><span></span><span></span>
      </div>
      
      <h2>SOMOS FACILITADORES DE PROCESOS RESTAURATIVOS EN ENTORNOS ESCOLARES</h2>
      
      <p class="_2-subtitle">Acompañamos a estudiantes, educadores y familias en entornos escolares urbanos y rurales.</p>
      
      <p class="_2-desc">Promovemos, prevenimos y atendemos con un mismo lente restaurativo: construimos vínculos
antes del conflicto, actuamos ante las primeras señales y acompañamos a reparar cuando hay daño.</p>
      
      <a href="/about_us" class="_2-link">CONOCER MÁS SOBRE NOSOTROS &rarr;</a>
    </div>

    <!-- Columna Derecha: Imagen adaptada con SVG y API WebP -->
    <div class="_2-image-card">
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <image
          href="<%= server_url %>/api/webp/public/_2.public.webp<%= `?v=${Date.now()}` %>"
          x="0"
          y="0"
          width="100%"
          height="100%"
          preserveAspectRatio="xMidYMid slice"
          style="opacity: 0; transition: opacity .5s ease-in;"
          onload="this.style.opacity='1'"
        />
      </svg>
    </div>
  </div>
</section>
