<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover"
    />

    <meta
      name="description"
      content="Accede para participar en eventos deportivos."
    >

    <link
      rel="icon"
      type="image/x-icon"
      href="<%= server_url %>/api/ico/logo/favicon.ico<%= `?v=${Date.now()}` %>"
    />

    <link
      rel="stylesheet"
      type="text/css"
      href="<%= server_url %>/api/css/public/reset.public.css<%= `?v=${Date.now()}` %>"
    />

    <link
      rel="stylesheet"
      type="text/css"
      href="<%= server_url %>/api/css/public/login.public.css<%= `?v=${Date.now()}` %>"
    />

    <title><%= title %></title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/">Inicio</a>
        <a href="/register"
          id="register"
          class="special"
        >Registrarse</a>
        <a href="/login"
          id="login"
          class="special"
        >Iniciar Sesión</a>
      </nav>
    </header>

    <hr />

    <main>
      <% if (error !== 'null') { %>
        <section class="alert">
          <span>Aviso: <%= error %></span>
        </section>
      <% } %>
      
      <section class="form-login">
        <header>
          <h2>Acceder a tu cuenta <span class="badge">FC-Plenitud</span></h2>

          <p>Ingresa tus credenciales.</p>
        </header>

        <hr />

        <form
          id="login"
          class="login"
          action="/login"
          method="POST"
        >
          <div class="first-row">
            <div class="email">
              <label for="email">Correo electrónico</label>

              <span class="input-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                >
                  <rect
                    x="3"
                    y="5"
                    width="18"
                    height="14"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <path
                    d="m4 7 8 6 8-6"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="tucorreo@ejemplo.com"
                required
              >
            </div>
          </div>

          <div class="second-row">
            <div class="password">
              <label for="password">Contraseña <span class="hint">(mínimo 8 caracteres)</span></label>

              <span class="input-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                >
                  <rect
                    x="4"
                    y="10"
                    width="16"
                    height="11"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <path
                    d="M8 10V7a4 4 0 0 1 8 0v3"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                </svg>
              </span>

              <input
                id="password"
                name="password"
                type="password"
                autocomplete="password"
                minlength="8"
                placeholder="Ingresa tu contraseña"
                required
              >

              <button
                id="toggle-password"
                class="toggle"
                type="button"
                aria-label="Mostrar contraseña"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="19"
                  height="19"
                  fill="none"
                >
                  <path
                    d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
                    stroke="currentColor"
                    stroke-width="1.7"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="2.5"
                    stroke="currentColor"
                    stroke-width="1.7"
                  />
                </svg>
              </button>

              <script>
                const bttn = document.getElementById('toggle-password');
                const npt_password = document.getElementById('password');

                bttn.addEventListener('click', () => {
                  const type = npt_password.type;
                  
                  if (type === 'password') npt_password.type = 'text';
                  else npt_password.type = 'password';
                });
              </script>
            </div>
          </div>

          <div class="third-row">
            <button type="submit">acceder</button>
  
            <span>
              ¿No tienes una cuenta?
              <a href="/register">Crear una cuenta</a>
            </span>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
